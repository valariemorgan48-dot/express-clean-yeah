generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYEE
  MANAGER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  employee     Employee?
  createdAt    DateTime @default(now())
}

model Employee {
  id         String   @id @default(cuid())
  name       String
  jobType    String
  hourlyRate Float    @default(0)
  userId     String?  @unique
  user       User?    @relation(fields: [userId], references: [id])
  timeEntries TimeEntry[]
  shifts     Shift[]
  templates  RecurringTemplate[]
  timeOffRequests TimeOffRequest[]
  jobRates   JobRate[]
  weeklyBonuses WeeklyBonus[]
  weekApprovals WeekApproval[]
  createdAt  DateTime @default(now())
}

model TimeEntry {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id])
  clockIn    DateTime
  clockOut   DateTime?
  jobType    String?
  address    String?
  rate       Float?
  createdAt  DateTime  @default(now())
}

model Shift {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id])
  date        DateTime
  time        String
  jobType     String
  address     String
  rate        Float?
  templateId  String?
  template    RecurringTemplate? @relation(fields: [templateId], references: [id])
  createdAt   DateTime  @default(now())
}

model RecurringTemplate {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  dayOfWeek  Int
  time       String
  jobType    String
  address    String
  active     Boolean  @default(true)
  shifts     Shift[]
  createdAt  DateTime @default(now())
}

enum RequestStatus {
  PENDING
  APPROVED
  DENIED
}

model TimeOffRequest {
  id         String        @id @default(cuid())
  employeeId String
  employee   Employee      @relation(fields: [employeeId], references: [id])
  startDate  DateTime
  endDate    DateTime
  reason     String?
  status     RequestStatus @default(PENDING)
  createdAt  DateTime      @default(now())
}

model JobRate {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  jobType    String
  rate       Float
  createdAt  DateTime @default(now())

  @@unique([employeeId, jobType])
}

model WeeklyBonus {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  weekStart  DateTime
  amount     Float
  note       String?
  createdAt  DateTime @default(now())

  @@unique([employeeId, weekStart])
}

model WeekApproval {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  weekStart  DateTime
  approvedAt DateTime @default(now())

  @@unique([employeeId, weekStart])
}
